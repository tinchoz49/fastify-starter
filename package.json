{
  "name": "fastify-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "A robust and modern starter template for building high-performance web applications using Fastify, TypeScript, and Drizzle ORM.",
  "author": "Martin Acosta",
  "license": "MIT",
  "keywords": [
    "fastify",
    "typescript",
    "drizzle",
    "orm",
    "starter",
    "template"
  ],
  "scripts": {
    "build": "bun build --compile --sourcemap --target bun --outfile serve --packages external ./src/serve.ts",
    "dev": "bun --env-file=.env.development --watch src/serve.ts",
    "start": "./serve",
    "lint": "eslint .",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:check": "bun run drizzle-kit check"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/type-provider-typebox": "^5.0.1",
    "@scalar/fastify-api-reference": "^1.25.58",
    "@sinclair/typebox": "^0.33.20",
    "@types/supertest": "^6.0.2",
    "drizzle-orm": "^0.35.3",
    "fastify": "^5.1.0",
    "fastify-better-error": "^0.0.5",
    "fastify-plugin": "^5.0.1",
    "oslo": "^1.2.1",
    "postgres": "^3.4.5",
    "supertest": "^7.0.0",
    "typebox-env": "^0.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@snaplet/copycat": "^5.1.0",
    "@types/bun": "latest",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.26.2",
    "eslint": "^9.14.0",
    "eslint-config-standard-ext": "^2.2.0",
    "typescript": "^5.6.3"
  }
}
